{
  "name": "aperitif",
  "private": true,
  "type": "module",
  "description": "Classic cocktail recipes, static site for GitHub Pages.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "python3 tools/build.py",
    "check": "python3 tools/build.py --check && node --test tools/tests/*.test.js",
    "serve": "python3 -m http.server 8000",
    "test:browser": "node --test --test-timeout=60000 tools/browser/*.test.js"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
